# --- Base de datos / JWT ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/demo
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_ALG=HS256
JWT_EXPIRES_MIN=60
PROJECT_NAME=Demo SaaS Distribuidoras
CORS_ORIGINS=["http://localhost:3000"]

# Rate limiting. Detrás de un proxy (el frontend que reenvía /api, nginx...) todos los usuarios
# llegan con la IP del proxy: poné cuántos proxies de confianza hay delante (normalmente 1) para
# usar la IP real de X-Forwarded-For. En una demo local con varios usuarios podés apagarlo.
RATE_LIMIT_ENABLED=True
TRUSTED_PROXY_HOPS=0
FRONTEND_ORIGIN=http://localhost:3000
ENV=dev
SQL_ECHO=false

# --- Multi-tenant ---
# Distribuidora inicial (se crea sola al arrancar si no existe) y su admin.
FIRST_TENANT_NAME=Principal
FIRST_TENANT_SLUG=main
FIRST_TENANT_DOMAIN=main.localhost
FIRST_SUPERUSER_EMAIL=admin@main.com
FIRST_SUPERUSER_PASSWORD=cambiar-esta-clave
# Admin de la PLATAFORMA (tabla admins): crea/desactiva distribuidoras desde
# /api/admin/login + /api/tenants. Se crea al arrancar si están las dos variables.
FIRST_ADMIN_NAME=Platform Admin
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
PLATFORM_AUTH_COOKIE_NAME=demo_platform_token

# --- Cookies de sesión ---
AUTH_COOKIE_NAME=districhocomap_token
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/

# --- Integraciones (opcionales) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=distri
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
RESEND_API_KEY=
ORDER_ADMIN_EMAIL=
ORDER_FROM_EMAIL=
