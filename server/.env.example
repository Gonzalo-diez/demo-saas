# --- Base de datos / JWT ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/demo
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_ALG=HS256
JWT_EXPIRES_MIN=60
PROJECT_NAME=Demo SaaS Distribuidoras
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_ORIGIN=http://localhost:3000
ENV=dev
SQL_ECHO=false

# --- Multi-tenant ---
# Distribuidora inicial (se crea sola al arrancar si no existe) y su admin.
FIRST_TENANT_NAME=Principal
FIRST_TENANT_SLUG=main
FIRST_SUPERUSER_EMAIL=admin@main.com
FIRST_SUPERUSER_PASSWORD=cambiar-esta-clave
# Clave de la PLATAFORMA para crear/desactivar distribuidoras (header X-Platform-Key).
# Vacía = esos endpoints quedan deshabilitados.
PLATFORM_ADMIN_KEY=cambiar-por-otra-clave-larga

# --- Cookies de sesión ---
AUTH_COOKIE_NAME=districhocomap_token
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/

# --- Integraciones (opcionales) ---
GEMINI_API_KEY=
GEMINI_MODEL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=distri
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
RESEND_API_KEY=
ORDER_ADMIN_EMAIL=
ORDER_FROM_EMAIL=
